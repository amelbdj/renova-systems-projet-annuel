# ============================================================
#  Modele de configuration - copie ce fichier en .env :
#     cp .env.example .env
#  puis adapte les valeurs (surtout les mots de passe et cles).
# ============================================================

# --- Port web (frontend) ---
# 80 pour la VM. En local si le port 80 est pris (WAMP), mets 8080.
WEB_PORT=80

# --- Base de donnees (MySQL 8) ---
MYSQL_ROOT_PASSWORD=change_me_root
DB_NAME=pa2026
DB_USER=upcycle
DB_PASS=change_me_app

# --- Stripe (laisser vide = valeurs par defaut du code) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- OneSignal (notifications push) ---
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=
